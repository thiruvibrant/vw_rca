# Dependencies
# no trailing slash: also ignores a node_modules symlink (one was committed on main by accident, 2026-11-09)
node_modules

# Build output
dist/

# Environment variables
.env
.env.local
.env.*.local

# convex/_generated is committed: `convex deploy --cmd` type-checks the frontend before codegen runs

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
bun.lockb

# Temp/test output
tmp/
test-results/
playwright-report/
# Local Convex dev backend state (npx convex dev, anonymous mode)
.convex/

# Local engine snapshot (clinic-level data): never commit
/data/
.vercel
.env*
